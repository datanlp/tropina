{
  "name": "tropina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env TROPINA_INCLUDE_TEST_DATA=1 TROPINA_INCLUDE_PLACEHOLDER_DATA=1 next dev",
    "preview": "cross-env TROPINA_INCLUDE_PLACEHOLDER_DATA=1 npm run build && next start",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && tsx scripts/validate-data.ts",
    "build": "next build",
    "build:e2e": "cross-env TROPINA_INCLUDE_TEST_DATA=1 npm run build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "validate:data": "tsx scripts/validate-data.ts",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.18.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lighthouse": "^13.6.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
